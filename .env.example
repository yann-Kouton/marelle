# Copie ce fichier en ".env" à la racine du projet et renseigne tes clés
# Firebase (Console Firebase > Paramètres du projet > Général > Vos applications > SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optionnel, pour l'upload d'avatars ou d'images plus tard (Cloudinary).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
