rules_version = '2';

// À déployer avec : firebase deploy --only firestore:rules
// (ou coller le contenu dans Console Firebase > Firestore Database > Règles)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlayerInRoom(room) {
      return isSignedIn() && (
        room.data.players.P1.uid == request.auth.uid ||
        (room.data.players.P2 != null && room.data.players.P2.uid == request.auth.uid)
      );
    }

    // Profils utilisateurs (pseudo + avatar) : lisibles par tous les joueurs
    // connectés (pour afficher l'avatar de l'adversaire), modifiables
    // uniquement par leur propriétaire — à une exception : le champ
    // `frames` (cadres de saison Diamant/Or/Bronze) n'est modifiable par
    // AUCUN client, même le propriétaire. Il n'est écrit que par le
    // Firebase Admin SDK depuis /api/season-rollover.js (Vercel), qui
    // bypasse ces règles, pour empêcher tout joueur de se l'auto-attribuer.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['frames']);
      allow delete: if false;
    }

    // Classement mondial par jeu et par saison : lecture ouverte à tout
    // joueur connecté, écriture limitée à sa propre entrée (empêche un
    // joueur de créditer une victoire à quelqu'un d'autre).
    match /leaderboardEntries/{entryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.gameId in ['marelle', 'awale'];
      allow delete: if false;
    }

    // Suivi de la dernière saison pour laquelle les cadres Diamant/Or/Bronze
    // ont été distribués (voir ensureSeasonRollover) — donnée non sensible.
    match /leaderboardMeta/{gameId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /rooms/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      // Création : uniquement par un utilisateur authentifié, comme P1, salon vide,
      // pour l'un des jeux reconnus (à tenir synchronisé avec src/games/registry.js).
      allow create: if isSignedIn()
        && request.resource.data.players.P1.uid == request.auth.uid
        && request.resource.data.players.P2 == null
        && request.resource.data.gameId in ['marelle', 'awale'];

      // Mise à jour : seuls les deux joueurs du salon peuvent écrire
      // (rejoindre en P2, jouer un coup, demander une revanche).
      allow update: if isPlayerInRoom(resource) || (
        isSignedIn() && resource.data.players.P2 == null
      );

      allow delete: if isPlayerInRoom(resource);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      // Signalisation WebRTC pour l'appel vocal : réservée aux deux joueurs
      // du salon (offer/answer + candidats ICE).
      match /voice/{callId} {
        allow read, write: if isPlayerInRoom(get(/databases/$(database)/documents/rooms/$(code)));

        match /{candidateCollection}/{candidateId} {
          allow read, write: if isPlayerInRoom(get(/databases/$(database)/documents/rooms/$(code)));
        }
      }
    }
  }
}
